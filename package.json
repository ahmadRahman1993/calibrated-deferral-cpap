{
  "name": "cpap-ncd-eval",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic CPAP prior-auth demo: approve or refer, with a calibrated auto-approve threshold.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/generator/generate.ts",
    "review-packet": "tsx src/generator/reviewPacket.ts",
    "demo": "node --env-file-if-exists=.env --import tsx src/eval/demo.ts",
    "eval:live": "node --env-file-if-exists=.env --import tsx src/eval/run.ts",
    "check:send": "tsx scripts/check-send.ts"
  },
  "dependencies": {
    "reliability-eval": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
